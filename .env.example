# Copy to .env for local development. Never commit real credentials.
AROX_ACCESS_TOKEN=replace-with-a-long-random-secret

# Gemini free-tier API key (create in Google AI Studio).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Optional paid providers; leave unset unless intentionally enabled.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
