# Copy to .env for local development. Never commit real credentials.
AROX_ACCESS_TOKEN=replace-with-a-long-random-secret

# OpenAI-compatible self-hosted gateways. Include the host only or a /v1 base path.
# Leave unset until each gateway has been deployed and secured.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Optional direct-provider fallback (may incur usage charges).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
