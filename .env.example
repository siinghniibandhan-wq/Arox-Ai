
# Central PostgreSQL Database (Shared State & Audit Log)
DB_USER=ai_orchestrator_role
DB_PASSWORD=strong_ai_secure_pass_123
DB_NAME=app_db
AWS_POSTGRES_HOST=<your-ec2-public-ip-or-dns>
AWS_POSTGRES_PORT=5433


# Automation & Outbound Webhooks (AWS)
N8N_USER=admin
N8N_PASSWORD=strong_n8n_password_here
N8N_WEBHOOK_URL=https://n8n.yourdomain.com/

# Telegram Bot Interface & Alerts
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
OWNER_TELEGRAM_ID=your_telegram_chat_id

# Cloud API Tokens (AWS production inference & local emergency fallback)
CLOUD_API_KEY=your_groq_or_openrouter_or_gemini_key
CLOUD_GATEWAY_URL=https://api.groq.com/openai/v1
CLOUD_MODEL_NAME=llama-3.3-70b-versatile

# Local Hardware Model (Loaded strictly in your machine's physical RAM)
LOCAL_MODEL_NAME=qwen2.5:7b
