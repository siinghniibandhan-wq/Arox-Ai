# Copy to .env for local development. Never commit real credentials.
AROX_ACCESS_TOKEN=replace-with-a-long-random-secret

# OpenAI-compatible self-hosted gateways. Include the host only or a /v1 base path.
# Leave unset until each gateway has been deployed and secured.
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto

OMNIROUTE_BASE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=auto

# Optional separate OpenAI-compatible endpoint for a GodMode integration.
# GodMode is a chat UI/project, not automatically an API gateway. Set these only
# if you deploy or configure a compatible API endpoint for this tab.
GODMODE_BASE_URL=
GODMODE_API_KEY=
GODMODE_MODEL=auto

# Optional direct-provider chat tabs (may incur usage charges).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
