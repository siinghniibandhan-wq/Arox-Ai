aroxai.duckdns.org {
    @public {
        method POST
        path /login /chat /logout
    }
    @site {
        method GET
        path / /manifest.json /sw.js
    }
    handle @public {
        reverse_proxy orchestrator:8000
    }
    handle @site {
        root * /srv/site
        file_server
    }
    handle {
        @noauth not header X-API-Key {env.API_KEY}
        respond @noauth "Unauthorized" 401
        reverse_proxy orchestrator:8000
    }
}
